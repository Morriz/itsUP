# itsUP host logs. Installed by bin/install-bringup.sh to
# /etc/logrotate.d/itsup; run by the host's daily logrotate.timer.

# Traefik access log. copytruncate keeps Traefik writing to the same inode
# across rotation, preserving the single-writer CrowdSec feed without a
# reopen signal.
{{ROOT}}/logs/access.log {
  size 10M
  rotate 5
  missingok
  notifempty
  compress
  delaycompress
  copytruncate
}

# API and Monitor logs (copytruncate keeps processes writing to the same file).
{{ROOT}}/logs/api.log {{ROOT}}/logs/monitor.log {
  size 10M
  rotate 5
  missingok
  notifempty
  compress
  delaycompress
  copytruncate
}
