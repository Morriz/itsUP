#!/usr/bin/env bash
# teleclaude: raw git commit backstop - partial-staging guard only.
set -euo pipefail

_tc_lib="${TELECLAUDE_HOME:-$HOME/.teleclaude}/bin/teleclaude-capabilities.sh"
if [ ! -f "$_tc_lib" ]; then
    echo "ERROR: teleclaude-capabilities.sh not found at $_tc_lib" >&2
    exit 1
fi
# shellcheck disable=SC1090
source "$_tc_lib"

if ! teleclaude_read_declaration "$(git rev-parse --show-toplevel)/teleclaude.yml"; then
    echo "ERROR: $TC_DECL_ERROR" >&2
    exit 1
fi

[ "$TC_DECL_CODE" = "1" ] || exit 0

exec telec code pre-commit
